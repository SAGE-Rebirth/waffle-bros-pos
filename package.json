{
  "name": "waffle-bros-pos",
  "version": "0.1.0",
  "private": true,
  "description": "Locally hosted point-of-sale and revenue-target dashboard for Waffle Bros, Bhopal",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "vite build",
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "setup": "npm install && vite build",
    "demo": "node --disable-warning=ExperimentalWarning server/seed-demo.js",
    "sync": "node --disable-warning=ExperimentalWarning server/sheets.js --once",
    "start:demo": "node --disable-warning=ExperimentalWarning scripts/start-demo.js"
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.1.0",
    "vite": "^6.3.5"
  }
}
